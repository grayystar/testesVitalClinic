# Conexão com o banco de dados MySQL "vitalclinic" (ver vitalclinic_schema.sql)
VCTCC_DB_HOST=127.0.0.1
VCTCC_DB_PORT=3306
VCTCC_DB_NAME=vitalclinic
VCTCC_DB_USER=root
VCTCC_DB_PASS=

# Modo legado (não usado por padrão; mantido apenas por referência histórica)
VCTCC_DATA_MODE=mysql
VCTCC_API_URL=
VCTCC_API_TOKEN=
VCTCC_API_TIMEOUT=8

# Envio de e-mail (fluxo "Esqueci minha senha")
# transport=log   -> apenas simula o envio, gravando em storage/mail_outbox.log (padrão, ideal para dev/homologação)
# transport=smtp  -> envia de verdade via um servidor SMTP (RECOMENDADO para produção)
# transport=mail  -> usa mail() nativo do PHP (requer sendmail/MTA já configurado no servidor)
VCTCC_MAIL_TRANSPORT=log
VCTCC_MAIL_FROM=no-reply@vitalclinic.local
VCTCC_MAIL_FROM_NAME="Vital Clinic"

# Credenciais SMTP (usadas somente quando VCTCC_MAIL_TRANSPORT=smtp)
# Exemplo com Gmail:
#   Host: smtp.gmail.com | Porta: 587 | Encryption: tls
#   Usuário: seu-email@gmail.com
#   Senha:  uma "Senha de app" gerada em https://myaccount.google.com/apppasswords
#           (a senha normal da conta Google NÃO funciona aqui)
# Exemplo com Mailtrap (caixa de teste, ótimo para homologação):
#   Host: sandbox.smtp.mailtrap.io | Porta: 587 | Encryption: tls
#   Usuário/senha: gerados no painel do Mailtrap
VCTCC_MAIL_SMTP_HOST=
VCTCC_MAIL_SMTP_PORT=587
VCTCC_MAIL_SMTP_USER=
VCTCC_MAIL_SMTP_PASS=
VCTCC_MAIL_SMTP_ENCRYPTION=tls
VCTCC_MAIL_SMTP_TIMEOUT=10
